# ═══════════════════════════════════════════════════════════
#  AI Cheatsheet Pipeline — API Keys
# ═══════════════════════════════════════════════════════════

# Step 1, 4, 5: Gemini 3.1 Pro (Understand User + Build Prompt + Generate Content)
GEMINI_PRO_API_KEY=your_gemini_pro_key_here

# Step 2: Nano Banana Pro (Analyze Old Image)
GEMINI_NANO_API_KEY=your_nano_banana_key_here

# Step 3: Deep Research Pro (Trend + Style Upgrade)
DEEP_RESEARCH_API_KEY=your_deep_research_key_here

# Step 6: Imagen 4 Ultra (Generate Cheatsheet Image)
IMAGEN_API_KEY=your_imagen_key_here

# ═══════════════════════════════════════════════════════════
#  Pipeline Configuration
# ═══════════════════════════════════════════════════════════
PIPELINE_MODE=development
MAX_IMAGE_SIZE=4096
OUTPUT_FORMAT=pdf
TEMPERATURE=0.7
TOP_P=0.9
